{
  "name": "mamtu",
  "main": "worker.js",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mamtu_db",
      "database_id": "9912a210-792e-4cd6-b9ab-9b0500ee93b5"
    }
  ]
}
